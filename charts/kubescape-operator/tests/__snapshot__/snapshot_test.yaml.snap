            app.kubernetes.io/part-of: kubescape
            kubescape.io/ignore: "true"
            tier: ks-control-plane
        spec:
          containers:
            - command:
                - /scripts/direct-keygen.sh
              env:
                - name: PUB_NS
                  value: kubescape
                - name: PRIV_NS
                  value: kubescape
              image: quay.io/kubescape/kubectl:1.36.1
              imagePullPolicy: IfNotPresent
              name: keygen
              resources:
                limits:
