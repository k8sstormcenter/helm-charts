            checksum/cloud-secret: 435193bc039d949c849ba4b141adeb4836e4d0fdcc4bf0b9588d0e36de86c424
            checksum/operator-config: 187a62efd186ded4da729da53b8475e22b017498f8c7b2ef5f7bf6496a9f0daf
