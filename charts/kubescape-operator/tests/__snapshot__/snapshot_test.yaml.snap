            kubescape.io/ignore: "true"
            tier: ks-control-plane
        spec:
          containers:
            - command:
                - /scripts/direct-keygen.sh
              env:
                - name: PUB_NS
                  value: kubescape
                - name: PRIV_NS
                  value: kubescape
              image: quay.io/kubescape/kubectl:1.36.1
              imagePullPolicy: IfNotPresent
              name: keygen
              resources:
                limits:
                  cpu: 200m
                  memory: 128Mi
                requests:
                  cpu: 10m
                  memory: 32Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsNonRoot: true
                runAsUser: 1000
              volumeMounts:
                - mountPath: /scripts
                  name: scripts
                - mountPath: /tmp
                  name: tmp
          restartPolicy: OnFailure
          serviceAccountName: node-agent-direct-keygen
          volumes:
