        {
          "excludeNamespaces": "kube-system,kube-public,kube-node-lease,kubeconfig,gmp-system,gmp-public",
          "namespace": "kubescape",
          "podScanGuardTime": "1h",
          "excludeJsonPaths":null,
          "httpExporterConfig":{"maxAlertsPerMinute":1000,"method":"POST","url":"http://synchronizer:8089/apis/v1/kubescape.io"},
          "nodeAgentAutoscaler": {
            "enabled": true,
            "nodeGroupLabel": "node.kubernetes.io/instance-type",
            "resourcePercentages": {
              "requestCPU": 2,
              "requestMemory": 2,
              "limitCPU": 5,
              "limitMemory": 5
            },
            "minResources": {
              "cpu": "100m",
              "memory": "600Mi"
            },
            "maxResources": {
              "cpu": "2000m",
              "memory": "4Gi"
            },
            "reconcileInterval": "5m",
