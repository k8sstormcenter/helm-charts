      jobTemplate:
        spec:
          template:
            metadata:
              annotations: null
              labels:
                app: helm-release-upgrader
                app.kubernetes.io/component: helm-release-upgrader
                app.kubernetes.io/instance: RELEASE-NAME
                app.kubernetes.io/managed-by: Helm
                app.kubernetes.io/name: kubescape-operator
