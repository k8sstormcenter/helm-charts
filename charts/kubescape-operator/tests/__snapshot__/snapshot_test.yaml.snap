            "networkServiceEnabled": true,
            "malwareDetectionEnabled": false,
            "hostMalwareSensorEnabled": false,
            "hostNetworkSensorEnabled": false,
            "dnsReportFailures": true,
            "nestedContainersEnabled": false,
            "nestedContainerRules": ["R0010","R1002","R1004","R1005","R1006","R1015","R1032"],
            "hostSensorEnabled": true,
            "hostSensorInterval": "5m",
            "nodeProfileServiceEnabled": true,
            "networkStreamingEnabled": true,
            "maxImageSize": 5.36870912e+09,
            "maxSBOMSize": 2.097152e+07,
            "sbomGenerationEnabled": true,
            "enableEmbeddedSBOMs": false,
            "seccompServiceEnabled": true,
            "seccompProfileBackend": "crd",
            "initialDelay": "2m",
            "updateDataPeriod": "10m",
            "hostProfileUpdateDataPeriod": "30m",
            "nodeProfileInterval": "10m",
            "networkStreamingInterval": "2m",
            "maxSniffingTimePerContainer": "24h",
            "bundleTrustPolicyPath": "/etc/bundle/trust-policy.json",
            "excludeNamespaces": "kube-system,kube-public,kube-node-lease,kubeconfig,gmp-system,gmp-public",
            "excludeLabels":null,
            "exporters": {
              "httpExporterConfig":{"maxAlertsPerMinute":1000,"method":"POST","url":"http://synchronizer:8089/apis/v1/kubescape.io"},
              "alertManagerExporterUrls":[],
              "stdoutExporter":true,
              "syslogExporterURL": ""
            },
            "excludeJsonPaths":null,
            "ruleCooldown": {
                "ruleCooldownDuration": "1h",
                "ruleCooldownAfterCount": 1,
                "ruleCooldownOnProfileFailure": true,
                "ruleCooldownMaxSize": 20000
            },
            "alertDeduplication": {
                "bypass": true
            },
            "scanFailureReporting": false,
            "suggester": {"bobctlPath":"/usr/bin/bobctl","defaultBundle":"","delta":{"argsLiteralCap":3,"enabled":false,"expiry":"24h"},"enabled":false,"eventInterval":"10m","maxPerMinute":10,"mode":"whole","peers":{"crossNamespace":false,"enabled":false},"queueSize":64,"scope":"network","skipNamespaces":["kube-system","kubescape"],"timeout":"60s","workDir":"/tmp/suggester"}
