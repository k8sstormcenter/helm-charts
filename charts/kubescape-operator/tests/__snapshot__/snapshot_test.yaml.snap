            checksum/cloud-config: 7da07057bf937ff0696ca0d10892aabfb88a0f77e93425bfd642ec17d1213c1d
            checksum/cloud-secret: 435193bc039d949c849ba4b141adeb4836e4d0fdcc4bf0b9588d0e36de86c424
            checksum/operator-config: 2c38afecb133237133006573633bfbeb920db9fba2937e016c6d11ccefd08150
            checksum/proxy-config: c03b6781aa61faaacfa84a96809236591dde0cbd43a204e05d5ba3044bb9d5d8
          labels:
