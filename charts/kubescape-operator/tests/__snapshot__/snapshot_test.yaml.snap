          "nodeAgentAutoscaler": {
            "enabled": true,
            "nodeGroupLabel": "node.kubernetes.io/instance-type",
            "resourcePercentages": {
              "requestCPU": 2,
              "requestMemory": 2,
              "limitCPU": 5,
              "limitMemory": 5
            },
            "minResources": {
              "cpu": "100m",
              "memory": "180Mi"
            },
            "maxResources": {
              "cpu": "2000m",
              "memory": "4Gi"
            },
            "reconcileInterval": "5m",
            "templatePath": "/etc/templates/daemonset-template.yaml",
            "operatorDeploymentName": "operator",
