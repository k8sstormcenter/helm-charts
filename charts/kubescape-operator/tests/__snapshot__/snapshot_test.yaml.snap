                  readOnly: true
                  subPath: capabilities.json
                - mountPath: /etc/config/config.json
                  name: config
                  readOnly: true
                  subPath: config.json
                - mountPath: /etc/ssl/certs/ca-certificates.crt
                  name: custom-ca-certificates
                  subPath: ca-certificates.crt
                - mountPath: /etc/certs
                  name: tls-certs
                  readOnly: true
                - mountPath: /etc/ssl/certs/proxy.crt
                  name: proxy-secret
                  subPath: proxy.crt
          imagePullSecrets:
            - name: foo
            - name: bar
