        spec:
          containers:
            - command:
                - /scripts/direct-keygen.sh
              env:
                - name: PUB_NS
                  value: kubescape
                - name: PRIV_NS
                  value: kubescape
              image: quay.io/kubescape/kubectl:1.36.1
